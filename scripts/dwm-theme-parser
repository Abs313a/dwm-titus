#!/usr/bin/env python3
"""dwm-theme-parser — High-performance TOML parser for dwm-titus themes."""

import os
import shlex
import sys
import tomllib
from pathlib import Path


def default_themes_file() -> Path:
    config_home = os.environ.get("XDG_CONFIG_HOME")
    if not config_home or not config_home.startswith("/"):
        home = os.environ.get("HOME", "")
        config_home = os.path.join(home, ".config") if home else "/tmp"
    user_file = Path(config_home) / "dwm-titus" / "themes.toml"
    if user_file.is_file():
        return user_file

    data_home = os.environ.get("XDG_DATA_HOME")
    if not data_home or not data_home.startswith("/"):
        home = os.environ.get("HOME", "")
        data_home = os.path.join(home, ".local", "share") if home else "/tmp"
    managed_file = Path(data_home) / "dwm-titus" / "config" / "themes.toml"
    return managed_file


def load_toml(path: Path) -> dict:
    if not path.is_file():
        sys.stderr.write(f"dwm-theme-parser: file not found: {path}\n")
        sys.exit(1)
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except Exception as e:
        sys.stderr.write(f"dwm-theme-parser: failed to parse {path}: {e}\n")
        sys.exit(1)


def cmd_active(args: list[str]) -> None:
    path = Path(args[0]) if args else default_themes_file()
    data = load_toml(path)
    active = data.get("active", {})
    if not isinstance(active, dict):
        sys.stderr.write("dwm-theme-parser: [active] section is not a table\n")
        sys.exit(1)
    theme = active.get("theme")
    if not theme or not isinstance(theme, str):
        sys.stderr.write("dwm-theme-parser: no active theme found\n")
        sys.exit(1)
    print(theme)


def cmd_get(args: list[str]) -> None:
    if len(args) < 2:
        sys.stderr.write("usage: dwm-theme-parser get <section> <key> [file]\n")
        sys.exit(2)
    section_name, key = args[0], args[1]
    path = Path(args[2]) if len(args) > 2 else default_themes_file()
    data = load_toml(path)

    # Navigate section (e.g. "theme.nord" -> data["theme"]["nord"])
    cur = data
    for part in section_name.split("."):
        if isinstance(cur, dict) and part in cur:
            cur = cur[part]
        else:
            cur = None
            break

    if cur is None or not isinstance(cur, dict) or key not in cur:
        sys.exit(1)

    val = cur[key]
    if isinstance(val, bool):
        print("true" if val else "false")
    else:
        print(val)


def cmd_validate_structure(args: list[str]) -> None:
    path = Path(args[0]) if args else default_themes_file()
    if not path.is_file():
        sys.stderr.write(f"dwm-theme-parser: not a regular file: {path}\n")
        sys.exit(1)
    # Check for hardlinks or invalid permissions if needed
    try:
        with open(path, "rb") as f:
            data = tomllib.load(f)
    except Exception as e:
        sys.stderr.write(f"dwm-theme-parser: syntax error: {e}\n")
        sys.exit(1)

    active = data.get("active")
    if not isinstance(active, dict) or "theme" not in active:
        sys.stderr.write("dwm-theme-parser: missing valid [active] theme\n")
        sys.exit(1)
    theme_val = active["theme"]
    if not isinstance(theme_val, str) or not theme_val.strip():
        sys.stderr.write("dwm-theme-parser: active theme is not a valid string\n")
        sys.exit(1)


def cmd_dump_theme(args: list[str]) -> None:
    if not args:
        sys.stderr.write("usage: dwm-theme-parser dump-theme <theme_name> [file]\n")
        sys.exit(2)
    theme_name = args[0]
    path = Path(args[1]) if len(args) > 1 else default_themes_file()
    data = load_toml(path)

    themes = data.get("theme", {})
    if not isinstance(themes, dict) or theme_name not in themes:
        sys.stderr.write(f"dwm-theme-parser: theme '{theme_name}' not found\n")
        sys.exit(1)

    t = themes[theme_name]
    if not isinstance(t, dict):
        sys.stderr.write(f"dwm-theme-parser: theme '{theme_name}' is not a table\n")
        sys.exit(1)

    print(f"THEME_NAME={shlex.quote(theme_name)}")
    dark_mode = t.get("dark_mode", True)
    print(f"DARK_MODE={shlex.quote('true' if dark_mode else 'false')}")
    if "gtk_theme" in t:
        print(f"GTK_THEME={shlex.quote(str(t['gtk_theme']))}")

    # Standard colors mapping
    for key, val in t.items():
        if key in ("dark_mode", "gtk_theme"):
            continue
        # Upper-case shell identifier
        upper_key = key.upper()
        if isinstance(val, bool):
            val_str = "true" if val else "false"
        else:
            val_str = str(val)
        print(f"{upper_key}={shlex.quote(val_str)}")


def cmd_list_themes(args: list[str]) -> None:
    path = Path(args[0]) if args else default_themes_file()
    data = load_toml(path)
    themes = data.get("theme", {})
    if isinstance(themes, dict):
        for name in themes.keys():
            print(name)


def main() -> None:
    if len(sys.argv) < 2:
        sys.stderr.write(
            "usage: dwm-theme-parser {active|get|validate-structure|dump-theme|list-themes} [args...]\n"
        )
        sys.exit(2)

    cmd = sys.argv[1]
    args = sys.argv[2:]

    if cmd == "active":
        cmd_active(args)
    elif cmd == "get":
        cmd_get(args)
    elif cmd == "validate-structure":
        cmd_validate_structure(args)
    elif cmd == "dump-theme":
        cmd_dump_theme(args)
    elif cmd == "list-themes":
        cmd_list_themes(args)
    else:
        sys.stderr.write(f"dwm-theme-parser: unknown command '{cmd}'\n")
        sys.exit(2)


if __name__ == "__main__":
    main()
